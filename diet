
# Windows 10 / 11 Debloat Script

$apps = @(
    "Microsoft.Copilot"
    "Microsoft.MicrosoftOfficeHub"
    "Microsoft.OneDriveSync"
    "Microsoft.549981C3F5F10"
    "Microsoft.MicrosoftPowerBI"
    "Microsoft.XboxApp"
    "Microsoft.XboxGamingOverlay"
    "Microsoft.XboxGameOverlay"
    "Microsoft.XboxIdentityProvider"
    "Microsoft.XboxSpeechToTextOverlay"
    "Microsoft.Xbox.TCUI"
    "Microsoft.GamingApp"
    "Microsoft.GamingServices"
)

Write-Host "Removing Windows bloatware..." -ForegroundColor Cyan

foreach ($app in $apps) {

    # Remove installed applications
    $packages = Get-AppxPackage -AllUsers -Name $app `
        -PackageTypeFilter Bundle,Main |
        Sort-Object IsBundle -Descending

    foreach ($pkg in $packages) {

        if ($pkg.NonRemovable) {
            Write-Host "Protected: $app" -ForegroundColor Yellow
            continue
        }

        # Skip packages already removed with their bundle
        if (-not (Get-AppxPackage -AllUsers -Name $app `
            -PackageTypeFilter Bundle,Main |
            Where-Object PackageFullName -eq $pkg.PackageFullName)) {
            continue
        }

        try {
            Remove-AppxPackage -Package $pkg.PackageFullName `
                -AllUsers -ErrorAction Stop

            Write-Host "Removed: $app" -ForegroundColor Green
        }
        catch {
            Write-Warning "Could not remove $app for all users."

            Get-AppxPackage -Name $app |
                Where-Object { -not $_.NonRemovable } |
                ForEach-Object {
                    try {
                        Remove-AppxPackage -Package $_.PackageFullName `
                            -ErrorAction Stop

                        Write-Host "Removed for current user: $app" -ForegroundColor Green
                    }
                    catch {
                        Write-Warning "Skipped: $app"
                    }
                }
        }
    }

    # Prevent installation for new users
    Get-AppxProvisionedPackage -Online |
        Where-Object { $_.DisplayName -eq $app } |
        ForEach-Object {
            try {
                Remove-AppxProvisionedPackage -Online `
                    -PackageName $_.PackageName `
                    -ErrorAction Stop | Out-Null
            }
            catch {
                Write-Warning "Could not deprovision: $app"
            }
        }
}

# Remove desktop applications
if (Get-Command winget -ErrorAction SilentlyContinue) {

    foreach ($app in @("Microsoft.OneDrive", "Microsoft.PowerBI")) {

        Write-Host "Uninstalling $app..." -ForegroundColor Cyan

        winget uninstall --id $app --exact --silent `
            --accept-source-agreements

        if ($LASTEXITCODE -ne 0) {
            Write-Warning "$app not found or uninstall failed."
        }
    }
}
else {
    Write-Warning "WinGet unavailable."
}

# Disable legacy Windows Copilot for current user
$path = "HKCU:\SOFTWARE\Policies\Microsoft\Windows\WindowsCopilot"

New-Item -Path $path -Force | Out-Null

Set-ItemProperty -Path $path `
    -Name "TurnOffWindowsCopilot" `
    -Value 1 -Type DWord

Write-Host "`nDebloat finished. Review warnings." -ForegroundColor Green
Write-Host "Restart your computer." -ForegroundColor Cyan
